# Assistant Configuration
ASSISTANT_NAME=Calcifer
ASSISTANT_HAS_OWN_NUMBER=false

# Channel Tokens
# Telegram: Create a bot via @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Discord: Get a token from https://discord.com/developers/applications
# Required intents: MESSAGE CONTENT INTENT
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Fastmail Integration (optional)
# Create an app password at https://www.fastmail.com/settings/security/integrations
FASTMAIL_EMAIL=your_email@fastmail.com
FASTMAIL_APP_PASSWORD=your_app_password_here

OLLAMA_HOST=

# Android SMS Gateway (optional)
SMS_GATEWAY_URL=http://<tailscale-ip>:8080
SMS_GATEWAY_USER=sms
SMS_GATEWAY_PASS=your_password_here
SMS_WEBHOOK_PORT=8767
